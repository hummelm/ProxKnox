#
# {{ ansible_managed }} — CIS 4.1
#
log_file = /var/log/audit/audit.log
log_group = adm
log_format = ENRICHED
flush = INCREMENTAL_ASYNC
freq = 50
max_log_file = {{ pve_cis_audit_max_log_file }}
max_log_file_action = {{ pve_cis_audit_max_log_file_action }}
max_log_file_action_exempt_uid = ""
num_logs = 5
name_format = HOSTNAME
space_left = 75
space_left_action = email
action_mail_acct = root
admin_space_left = 50
admin_space_left_action = halt
disk_full_action = halt
disk_error_action = halt
